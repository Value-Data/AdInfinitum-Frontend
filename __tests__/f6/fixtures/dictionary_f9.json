    {"key": "ponds.entrainment_pct", "entity": "ponds", "field": "entrainment_pct", "category": "model", "data_type": "number", "label": "Impregnación (%)", "description": "Porcentaje de salmuera que queda atrapada en la sal precipitada y no se recupera. Obligatorio, sin valor por defecto.", "unit": "%", "formula": "entrainment_t_d = salt_precipitated_t_d * p / (100 - p)", "min_value": 0.0, "max_value": 100.0, "min_inclusive": true, "max_inclusive": false, "required": true, "time_variable": true, "ui_section": "balance", "ui_order": 5, "section_kinds": ["precon_static", "precon_dynamic", "postliming_static", "postliming_dynamic"], "read_only": false},
